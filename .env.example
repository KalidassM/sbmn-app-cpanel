PORT=3000

# cPanel MySQL Databases - create the DB and user in cPanel first (names are usually prefixed
# with your cPanel username, e.g. youruser_sbmn / youruser_sbmnuser)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Set to a long random string in production - falls back to an insecure default otherwise
JWT_SECRET=

# Your cPanel domain, e.g. https://portal.yourdomain.org
APP_PUBLIC_URL=

# WhatsApp Business Cloud API (Meta) - from developers.facebook.com/apps, WhatsApp product
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=v20.0
